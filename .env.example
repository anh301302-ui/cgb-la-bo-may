# Discord Bot Credentials (from Discord Developer Portal)
BOT_TOKEN=your_discord_bot_token_here
OAUTH2_CLIENT_ID=your_discord_application_client_id
OAUTH2_CLIENT_SECRET=your_discord_oauth2_client_secret
OAUTH2_REDIRECT_URI=https://your-domain.vercel.app/api/auth/callback

# Security
JWT_SECRET=generate_a_random_32+_character_secret_here
CSRF_SECRET=another_random_32+_character_secret_here

# GeeTest CAPTCHA v4 (GEETEST_KEY is server-only; never expose it to the browser)
CAPTCHA=true
GEETEST_ID=your_geetest_v4_captcha_id
GEETEST_KEY=your_geetest_v4_captcha_key

# Vercel Cron authentication (any random string; Vercel sends it back as
# "Authorization: Bearer <value>" when triggering scheduled cron jobs)
CRON_SECRET=generate_another_random_32+_character_secret_here

# Vercel KV (Redis) - from Vercel Dashboard > Storage > KV
KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
KV_REST_API_TOKEN=your_kv_token_here

# App Config
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NODE_ENV=production
